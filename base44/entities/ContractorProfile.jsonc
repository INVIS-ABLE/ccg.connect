{
  "name": "ContractorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "contractor_reference": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "suspended",
        "rejected",
        "archived"
      ],
      "default": "pending"
    },
    "trading_name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "company_number": {
      "type": "string"
    },
    "tax_or_vat_reference": {
      "type": "string"
    },
    "primary_trade": {
      "type": "string"
    },
    "biography": {
      "type": "string"
    },
    "base_postcode": {
      "type": "string"
    },
    "postcode_district": {
      "type": "string"
    },
    "service_radius_miles": {
      "type": "number"
    },
    "maximum_travel_miles": {
      "type": "number"
    },
    "transport_available": {
      "type": "boolean",
      "default": true
    },
    "day_rate": {
      "type": "number"
    },
    "hourly_rate": {
      "type": "number"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "available",
        "partially_available",
        "unavailable",
        "on_assignment"
      ],
      "default": "available"
    },
    "preferred_contractor": {
      "type": "boolean",
      "default": false
    },
    "internal_risk_status": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ],
      "default": "low"
    },
    "private_admin_notes": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspended_reason": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id"
  ]
}
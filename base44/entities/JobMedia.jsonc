{
  "name": "JobMedia",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "document"
      ],
      "default": "image"
    },
    "category": {
      "type": "string",
      "enum": [
        "before",
        "progress",
        "completion",
        "materials",
        "delivery",
        "variation",
        "defect",
        "snagging",
        "incident",
        "other"
      ],
      "default": "progress"
    },
    "file_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "original_filename": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "internal_only": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "job_id",
    "uploaded_by",
    "file_url"
  ]
}
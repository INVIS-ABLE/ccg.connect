{
  "name": "ChecklistTemplateItem",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "requires_file": {
      "type": "boolean",
      "default": false
    },
    "requires_signature": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "template_id",
    "title"
  ]
}
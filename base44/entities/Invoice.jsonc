{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "contractor_to_ccg",
        "ccg_to_client"
      ],
      "default": "contractor_to_ccg"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "net_amount": {
      "type": "number"
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "vat_amount": {
      "type": "number"
    },
    "gross_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "sent",
        "paid",
        "overdue",
        "disputed",
        "cancelled"
      ],
      "default": "draft"
    },
    "file_url": {
      "type": "string"
    },
    "linked_timesheet_ids": {
      "type": "string"
    },
    "exported_to": {
      "type": "string"
    },
    "external_reference": {
      "type": "string"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "job_id"
  ]
}
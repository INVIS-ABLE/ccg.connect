{
  "name": "CredentialType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety_card",
        "gas_registration",
        "trade_qualification",
        "working_at_height",
        "asbestos",
        "first_aid",
        "management",
        "insurance",
        "other"
      ]
    },
    "requires_expiry": {
      "type": "boolean",
      "default": true
    },
    "verification_url_template": {
      "type": "string"
    },
    "default_client_visible": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}
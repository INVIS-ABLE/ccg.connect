{
  "name": "Job",
  "type": "object",
  "properties": {
    "job_reference": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "full_scope": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "site_postcode": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "trade_category": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_duration": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "hourly_rate": {
      "type": "number"
    },
    "day_rate": {
      "type": "number"
    },
    "headcount_required": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "new_lead",
        "draft",
        "ready_to_match",
        "offers_sent",
        "assigned",
        "in_progress",
        "on_hold",
        "awaiting_contractor_action",
        "awaiting_client_approval",
        "snagging",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "client_contact_name": {
      "type": "string"
    },
    "client_contact_phone": {
      "type": "string"
    },
    "access_instructions": {
      "type": "string"
    },
    "parking_instructions": {
      "type": "string"
    },
    "health_and_safety_notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "client_visible_notes": {
      "type": "string"
    },
    "assignment_locked": {
      "type": "boolean",
      "default": false
    },
    "created_from_lead": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}
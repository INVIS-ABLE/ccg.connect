{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "ops_admin",
        "contractor",
        "client"
      ],
      "default": "contractor"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "suspended",
        "archived"
      ],
      "default": "pending"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy_accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "role"
  ]
}
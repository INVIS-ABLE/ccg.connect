{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "site_postcode": {
      "type": "string"
    },
    "work_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "desired_dates": {
      "type": "string"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "either"
      ],
      "default": "either"
    },
    "attachment_urls": {
      "type": "string"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "converted",
        "rejected"
      ],
      "default": "new"
    },
    "converted_job_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "consent"
  ]
}
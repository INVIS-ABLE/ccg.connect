{
  "name": "ContractorCredential",
  "type": "object",
  "properties": {
    "contractor_id": {
      "type": "string"
    },
    "credential_type_id": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "registration_or_policy_number": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "file_url": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "awaiting_review",
        "verified",
        "rejected",
        "expired",
        "superseded"
      ],
      "default": "awaiting_review"
    },
    "verification_source": {
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "admin_only",
        "shareable_by_admin",
        "shared_with_client",
        "contractor_and_admin"
      ],
      "default": "contractor_and_admin"
    },
    "reminder_60_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_30_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_14_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_7_sent": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "contractor_id",
    "credential_type_id"
  ]
}
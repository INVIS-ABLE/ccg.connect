{
  "name": "ContractorAvailability",
  "type": "object",
  "properties": {
    "contractor_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "availability_type": {
      "type": "string",
      "enum": [
        "available",
        "partially_available",
        "unavailable",
        "on_assignment",
        "holiday"
      ],
      "default": "available"
    },
    "all_day": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "recurring_pattern": {
      "type": "string"
    }
  },
  "required": [
    "contractor_id",
    "start_date",
    "availability_type"
  ]
}
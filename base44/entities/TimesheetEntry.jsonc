{
  "name": "TimesheetEntry",
  "type": "object",
  "properties": {
    "timesheet_id": {
      "type": "string"
    },
    "work_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "finish_time": {
      "type": "string"
    },
    "break_minutes": {
      "type": "number",
      "default": 0
    },
    "total_hours": {
      "type": "number"
    },
    "rate": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string"
    },
    "contractor_signature": {
      "type": "string"
    },
    "client_signature": {
      "type": "string"
    }
  },
  "required": [
    "timesheet_id",
    "work_date"
  ]
}
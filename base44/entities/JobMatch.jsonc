{
  "name": "JobMatch",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "eligibility_status": {
      "type": "string",
      "enum": [
        "eligible",
        "ineligible"
      ],
      "default": "eligible"
    },
    "total_score": {
      "type": "number"
    },
    "skill_score": {
      "type": "number"
    },
    "distance_score": {
      "type": "number"
    },
    "availability_score": {
      "type": "number"
    },
    "credential_score": {
      "type": "number"
    },
    "delivery_history_score": {
      "type": "number"
    },
    "admin_preference_score": {
      "type": "number"
    },
    "explanation": {
      "type": "string"
    },
    "offer_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "sent",
        "viewed",
        "accepted",
        "declined",
        "expired",
        "withdrawn",
        "assigned_elsewhere"
      ],
      "default": "not_sent"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "decline_reason": {
      "type": "string"
    },
    "contractor_message": {
      "type": "string"
    },
    "selected_by_admin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "job_id",
    "contractor_id"
  ]
}
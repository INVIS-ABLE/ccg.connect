{
  // Cloudflare Workers config for CCG Connect (front-end + same-origin /api proxy).
  // Cloudflare's Git integration deploys this repo as a Worker with static assets
  // (`npx wrangler deploy`); this file is the source of truth so the deploy is
  // reproducible instead of relying on dashboard auto-detection.
  // Redeploy marker: 2026-06-22 (trigger a fresh build after env vars are set).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccg-connect",
  "main": "api/index.ts",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Canonical public origin. Declaring the custom domain here (rather than only in
  // the dashboard) makes the binding reproducible: on deploy, Cloudflare attaches
  // `app.cookconstructiongrowth.co.uk` to this Worker and creates the `app` DNS
  // record automatically. The zone (cookconstructiongrowth.co.uk) must be on this
  // Cloudflare account. Keep BETTER_AUTH_URL set to this same origin (see
  // docs/cloudflare-deployment.md) so sign-in redirects resolve correctly.
  "routes": [
    { "pattern": "app.cookconstructiongrowth.co.uk", "custom_domain": true }
  ],
  // Daily 07:00 UTC: credential-expiry reminders (see api/jobs/credentialExpiry.ts).
  "triggers": { "crons": ["0 7 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes resolve to the app shell; the Worker still runs first
    // for /api/* (see worker/index.js).
    "not_found_handling": "single-page-application"
  },
  // Cloudflare-native backend (migration off Base44 — see
  // docs/migration-to-cloudflare.md). The binding is available to the Worker now;
  // the Hono API in api/ is wired in during a later phase.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ccg-connect-db",
      "database_id": "3f02bebb-d008-4d49-ac6f-95a542a5891b",
      // Drizzle writes migrations here (see drizzle.config.ts `out`). Without this,
      // `wrangler d1 migrations apply` looks in the default ./migrations dir, finds
      // nothing, and silently creates no tables — so set it explicitly.
      "migrations_dir": "api/db/migrations"
    }
  ],
  // Private bucket for job media + credential documents (served only via the
  // authorized /api/media/:id/file route — never public). Create it once with
  // `npx wrangler r2 bucket create ccg-connect-media`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ccg-connect-media"
    }
  ],
  // Realtime chat: one Durable Object per conversation (see api/chat/ConversationRoom.ts).
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOMS", "class_name": "ConversationRoom" }]
  },
  // SQLite-backed DO class so it runs on the free plan (storage unused — pure fan-out).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationRoom"] }]
}
